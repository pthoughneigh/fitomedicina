# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment
.env

# Data — never commit real or user data
data/*
!data/.gitkeep

# Notebooks: outputs contain data and are noisy diffs
notebooks/*.ipynb

# Local databases
*.db
*.sqlite3

# Editor
.vscode/
.idea/

# Mypy / pytest / ruff caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
